# ==============================================================================
# YouTube Video Automation & Scheduling Platform - Docker Environment Configuration
# ==============================================================================

# Application Environment (development, production)
ENVIRONMENT=production
PROJECT_NAME="YouTube Video Automation Platform"

# Security & Encryption (MANDATORY: Generate with `python -c "import secrets; print(secrets.token_hex(32))"` and Fernet key)
SECRET_KEY=generate_a_secure_64_character_random_hex_key_here
ENCRYPTION_KEY=generate_a_valid_32_byte_base64_fernet_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for self-hosted or Postgres for multi-instance)
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db
# For PostgreSQL (docker-compose.prod.yml):
# DATABASE_URL=postgresql+asyncpg://yt_user:yt_secure_password_change_me@postgres:5432/yt_automation

# Storage & Temporary Paths
TEMP_STORAGE_PATH=/app/temp
LOCAL_STORAGE_BASE_PATH=/app/storage
LOGS_DIR=/app/logs

# Google Drive OAuth (Credentials from Google Cloud Console)
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/drive/oauth/callback

# YouTube Data API OAuth (Credentials from Google Cloud Console)
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback

# Concurrency & Worker Pool Limits
MAX_CONCURRENT_UPLOADS=3
PER_CHANNEL_MAX_CONCURRENT=1
CHANNEL_UPLOAD_COOLDOWN_SECONDS=5
MAX_UPLOAD_RETRIES=5

# CORS Settings (Allowed frontend origins)
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:5173"]
