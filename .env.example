# ============================================================
# YouTube Automation & Scheduling Platform Configuration
# ============================================================

# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Application Security
# Generate a strong 32-byte secret key (e.g. openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_for_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (default development): sqlite+aiosqlite:///./yt_automation.db
# For PostgreSQL (production): postgresql+asyncpg://user:password@localhost:5432/yt_automation
DATABASE_URL=sqlite+aiosqlite:///./yt_automation.db
SYNC_DATABASE_URL=sqlite:///./yt_automation.db

# Storage Provider (google_drive / local)
STORAGE_PROVIDER=local
TEMP_STORAGE_PATH=./temp_storage
LOCAL_STORAGE_BASE_PATH=./storage_test

# Google API Credentials (OAuth 2.0 Web Application Client)
# Obtain these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/drive/callback
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/channels/oauth/youtube/callback

# Scheduler Settings
SCHEDULER_HEARTBEAT_SECONDS=60
DEFAULT_UPLOAD_LEAD_MINUTES=180
MAX_UPLOAD_RETRIES=5

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
